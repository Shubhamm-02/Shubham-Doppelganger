# Copy to .env.local. Every variable is optional for local development: without
# OpenAI or Supabase, chat answers from local keyword search and keeps sessions
# in memory.

# --- Security (required in production) ---
# At least 32 characters, e.g. `openssl rand -base64 32`. Signs the visitor cookie.
VISITOR_COOKIE_SECRET=
# Optional, at least 32 characters. Send it as x-health-token to see /api/health details.
HEALTH_TOKEN=

# --- OpenAI: answers, routing, embeddings ---
OPENAI_API_KEY=
# Only for an OpenAI-compatible provider. Leave empty for OpenAI.
OPENAI_BASE_URL=
OPENAI_CHAT_MODEL=gpt-4.1-mini
OPENAI_ROUTER_MODEL=gpt-4.1-nano
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
# Must match the vector(...) size in supabase/schema.sql.
OPENAI_EMBEDDING_DIMENSIONS=1536

# --- Groq: fallback for answers and routing when OpenAI is missing or failing ---
# Groq has no embeddings API, so retrieval uses local keyword search while OpenAI is down.
GROQ_API_KEY=
GROQ_CHAT_MODEL=openai/gpt-oss-120b
# Must support strict structured outputs (the gpt-oss models do).
GROQ_ROUTER_MODEL=openai/gpt-oss-20b

# --- Supabase: vector index, sessions, chat history ---
# Server-side secret key (sb_secret_... or the legacy service_role JWT), never a publishable key.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# --- Rate limiting (Upstash Redis) ---
# Without these, limits apply per server instance. The Vercel Marketplace names
# KV_REST_API_URL / KV_REST_API_TOKEN also work.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --- Cal.com booking ---
CAL_API_KEY=
# Numeric id of the 15-minute event type.
CAL_EVENT_TYPE_ID=
# Comma-separated addresses that can never be the attendee. CAL_HOST_EMAIL (one address)
# is read too. Defaults to Shubham's two Gmail addresses.
CAL_HOST_EMAILS=
CAL_API_VERSION=2026-02-25
CAL_SLOTS_API_VERSION=2024-09-04
# Testing only: send Cal.com requests to a mock server. Leave empty for https://api.cal.com/v2.
CAL_API_BASE_URL=

# --- Vapi voice ---
# Shared with the Vapi tool server as the x-vapi-secret header. /api/vapi/tools returns 503 without it.
VAPI_WEBHOOK_SECRET=
# Browser voice calls; the voice button is disabled when either is empty.
NEXT_PUBLIC_VAPI_PUBLIC_KEY=
NEXT_PUBLIC_VAPI_ASSISTANT_ID=
# Only for `npm run vapi:configure`.
VAPI_API_KEY=
# Defaults to NEXT_PUBLIC_VAPI_ASSISTANT_ID.
VAPI_ASSISTANT_ID=
# Public URL of this app's tool endpoint, e.g. https://<your-domain>/api/vapi/tools.
VAPI_TOOLS_URL=
VAPI_MODEL=gpt-5-nano

# --- Site ---
# Canonical URL for metadata and social cards. Defaults to Vercel's
# VERCEL_PROJECT_PRODUCTION_URL, then https://shubham-doppelganger.vercel.app.
NEXT_PUBLIC_SITE_URL=

# --- GitHub ingestion (`npm run ingest:github`) ---
GITHUB_OWNER=Shubhamm-02
# Optional; raises the GitHub API rate limit.
GITHUB_TOKEN=
